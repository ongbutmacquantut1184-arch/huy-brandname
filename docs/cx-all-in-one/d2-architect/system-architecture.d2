users -> browser: "Use internal workflows"
browser -> next_app.pages: "Navigate pages"
next_app.pages -> next_app.actions: "Call server actions"
next_app.pages -> next_app.api: "Call API routes"
next_app.actions -> supabase.cx: "Read and write CX data"
next_app.actions -> supabase.rpc: "Generate IDs and search"
next_app.api -> supabase.cancellation: "Read and write cancellation data"
next_app.api -> supabase.cx.services: "Cancel matching services"
next_app.api -> supabase.cx.logs: "Write activity logs"
next_app.api.cron -> next_app.actions.cx_actions: "Process auto renew"
external.scheduler -> next_app.api.cron: "Scheduled GET"
next_app.api.cancellation -> external.sheets: "Async sync when configured"
next_app.api.reports -> supabase.cancellation: "Aggregate by provider and operator"
